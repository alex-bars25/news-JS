{
  "compilerOptions": {
    "module": "es2020",
    "target": "es2020",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
